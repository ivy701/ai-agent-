# Nusxa oling: .env nomi bilan saqlang va qiymatlarni to'ldiring

TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Asosiy AI (hozir sizda shu bor)
GEMINI_API_KEY=

# Bepul, tez zaxira AI — ishlatish tavsiya etiladi (console.groq.com/keys)
GROQ_API_KEY=

# Ixtiyoriy qo'shimcha zaxira
OPENROUTER_API_KEY=

# E'tiborga olinmaydigan (qora ro'yxat) chat ID yoki username'lar (vergul bilan)
IGNORED_CHATS=
